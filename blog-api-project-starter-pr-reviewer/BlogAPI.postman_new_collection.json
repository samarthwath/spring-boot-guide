      ]
    },
    {
      "name": "v1 - /api/v1/posts (NBlogController, NewPost storage)",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts?title=My First Post&content=This is the content of my first post",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "title", "value": "My First Post" },
                { "key": "content", "value": "This is the content of my first post" }
              ],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Create Post - Empty Title (now returns 400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts?title=&content=Content with no title here",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "title", "value": "" },
                { "key": "content", "value": "Content with no title here" }
              ],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Create Post - Content Too Short (now returns 400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts?title=Title&content=short",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "title", "value": "Title" },
                { "key": "content", "value": "short" }
              ],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Create Post - Content Too Long (now returns 400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts?title=Title&content={{content501chars}}",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "title", "value": "Title" },
                { "key": "content", "value": "{{content501chars}}" }
              ],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Get Post By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts/{{postId}}",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts", "{{postId}}"],
              "protocol": "http"
            },
            "description": "Ids are now UUIDs assigned by NewPost at creation time (no more index-based ids). Set the {{postId}} collection variable from a Create Post response before running this."
          }
        },
        {
          "name": "Get Post By ID - Not Found (now returns 404, no longer crashes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/posts/00000000-0000-0000-0000-000000000000",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts", "00000000-0000-0000-0000-000000000000"],
              "protocol": "http"
            }
          }
        },
