{
  "info": {
    "name": "Blog API - EmbarkX",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "v0 - /api/posts (BlogController, unchanged)",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"My First Post\", \"content\": \"This is the content of my first post\"}"
            },
            "url": {
              "raw": "http://localhost:8080/api/posts",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Create Post - Empty Title (Bug: no validation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"\", \"content\": \"Content with no title\"}"
            },
            "url": {
              "raw": "http://localhost:8080/api/posts",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Get Post By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts/0",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "0"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Get Post By ID - Out of Bounds (Bug: crashes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts/999",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "999"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Validate Content - OK",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts/validate?content=Short content",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "validate"],
              "query": [{ "key": "content", "value": "Short content" }],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Validate Content - Too Long (Bug: hardcoded 5000)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts/validate?content={{longContent}}",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "validate"],
              "query": [{ "key": "content", "value": "{{longContent}}" }],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/posts/0",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "0"],
              "protocol": "http"
            }
          }
        },
        {
          "name": "Delete Post - Invalid Index (Bug: crashes)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
