{
  "mcpServers": {
    "filesystem": {
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/d",
        "/c",
        "set \"PATH=C:\\Program Files\\nodejs;%PATH%\" && npx.cmd -y @modelcontextprotocol/server-filesystem \"C:\\development\\mcp\""
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL": "DUMMY "
      }
    }
  }
}